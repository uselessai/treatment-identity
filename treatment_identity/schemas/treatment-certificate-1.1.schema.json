{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:treatment-identity:treatment-certificate:1.1",
  "title": "Treatment identity certificate",
  "description": "Machine-readable evidence about the path reached and tensor delivered by an experimental pipeline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pipeline",
    "expected_treatment",
    "schema",
    "created_utc",
    "repository",
    "commit",
    "working_tree_dirty",
    "branch_reached",
    "delivery_modality",
    "gt_source",
    "lq_source",
    "gt_stream_sha256",
    "lq_stream_sha256",
    "channels",
    "value_range",
    "geometry",
    "unique_frames_reachable",
    "clip_length",
    "observed_operator_order",
    "target_transform_count",
    "training_seed",
    "render_seed",
    "data_order_seed",
    "uncontrolled_rng",
    "environment",
    "gates",
    "notes",
    "status",
    "failed_gates"
  ],
  "properties": {
    "pipeline": {
      "type": "string",
      "minLength": 1
    },
    "expected_treatment": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "treatment-certificate/1.1"
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": [
        "string",
        "null"
      ]
    },
    "commit": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "working_tree_dirty": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "branch_reached": {
      "type": [
        "string",
        "null"
      ]
    },
    "delivery_modality": {
      "type": [
        "string",
        "null"
      ]
    },
    "gt_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "lq_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "gt_stream_sha256": {
      "$ref": "#/$defs/nullableSha256"
    },
    "lq_stream_sha256": {
      "$ref": "#/$defs/nullableSha256"
    },
    "channels": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "value_range": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gt": {
              "$ref": "#/$defs/numericRange"
            },
            "lq": {
              "$ref": "#/$defs/numericRange"
            },
            "note": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          },
          "anyOf": [
            {
              "required": [
                "gt",
                "lq"
              ]
            },
            {
              "required": [
                "error"
              ]
            }
          ]
        }
      ]
    },
    "geometry": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "declared",
            "delivered",
            "source"
          ],
          "properties": {
            "declared": {
              "$ref": "#/$defs/shape"
            },
            "delivered": {
              "$ref": "#/$defs/shape"
            },
            "source": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "unique_frames_reachable": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "clip_length": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_operator_order": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "target_transform_count": {
      "type": [
        "number",
        "null"
      ]
    },
    "training_seed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "render_seed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "data_order_seed": {
      "type": [
        "integer",
        "string",
        "null"
      ]
    },
    "uncontrolled_rng": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "python",
        "platform",
        "packages"
      ],
      "properties": {
        "python": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "packages": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "additionalProperties": true
    },
    "gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNDECLARED",
        "PARTIAL",
        "INCONCLUSIVE"
      ]
    },
    "failed_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "undeclared_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "nullableSha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "numericRange": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "shape": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "status",
        "message",
        "evidence"
      ],
      "properties": {
        "gate": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNDECL",
            "SKIP",
            "N/A"
          ]
        },
        "message": {
          "type": "string"
        },
        "evidence": {
          "type": "object"
        }
      }
    }
  }
}
